{% extends 'base.html.twig' %}

{% block title %}Détails de l'utilisateur{% endblock %}

{% block body %}

<div class="container py-4 text-charte-dark">

    {% if is_granted('ROLE_ADMIN') and app.user != utilisateur %}

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Détails de l'utilisateur : {{ utilisateur.prenom }} {{ utilisateur.nom }}</h1>
            <a href="{{ path('app_utilisateur_index') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>Nom et prénom</th>
                    {% if utilisateur.roleObjet and utilisateur.roleObjet.libelle != 'Employé' %}
                        <th>Adresse</th>
                        <th>Ville</th>
                    {% endif %}
                    <th>Rôle</th>
                    {% if utilisateur.roleObjet and utilisateur.roleObjet.libelle != 'Employé' %}
                        <th>Vérifié</th>
                    {% endif %}
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ utilisateur.id }}</td>
                    <td>{{ utilisateur.email }}</td>
                    <td>{{ utilisateur.nom|upper }} {{ utilisateur.prenom }}</td>
                    
                    {% if utilisateur.roleObjet and utilisateur.roleObjet.libelle != 'Employé' %}
                        <td>{{ utilisateur.adressePostale|default('Non renseignée') }}</td>
                        <td>{{ utilisateur.ville|default('Non renseignée') }}</td>
                    {% endif %}
                    
                    <td>{{ utilisateur.roleObjet ? utilisateur.roleObjet.libelle : 'Client' }}</td>
                    
                    {% if utilisateur.roleObjet and utilisateur.roleObjet.libelle != 'Employé' %}
                        <td>
                            {% if utilisateur.isVerified %}
                                <span class="badge bg-success">Compte confirmé</span>
                            {% else %}
                                <span class="badge bg-danger">Email non vérifié</span>
                            {% endif %}
                        </td>
                    {% endif %}
                    
                    <td>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                            
                            <form method="post" action="{{ path('app_utilisateur_toggle', {'id': utilisateur.id}) }}" onsubmit="return confirm('Confirmer le changement de statut ?');">
                                <button class="btn btn-sm btn-outline-danger">
                                    {{ utilisateur.isVerified ? 'Désactiver' : 'Réactiver' }}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

    {% else %}
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Mon espace personnel</h1>
            <a href="{{ path('app_menu_index') }}" class="btn btn-outline-dark">Retour aux menus</a>
        </div>

        <div class="card p-4 shadow-sm mb-5 bg-white border-0 rounded">
            <h3 class="h5 mb-4 text-secondary border-bottom pb-2">Mes Informations</h3>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <span class="text-muted d-block small">Nom et prénom</span>
                    <strong>{{ utilisateur.nom|upper }} {{ utilisateur.prenom }}</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <span class="text-muted d-block small">Adresse Email Professionnelle</span>
                    <strong>{{ utilisateur.email }}</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <span class="text-muted d-block small">Numéro de téléphone</span>
                    <strong>{{ utilisateur.telephone ?? 'Non renseigné' }}</strong>
                </div>
            </div>
        </div>


        {% if not is_granted('ROLE_EMPLOYE') %}
            <div class="card p-4 shadow-sm mb-4 bg-white border-0 rounded">
                <h3 class="h5 mb-4 text-secondary border-bottom pb-2">Mes commandes</h3>

                {% if utilisateur.commandes is empty %}
                    <p class="text-muted">Vous n'avez pas encore passé de commande.</p>
                {% else %}
                    {% for commande in utilisateur.commandes %}

                        
                        {% set avisExistant = null %}
                        {% for a in utilisateur.avis %}
                            {% if a.commande and a.commande.id == commande.id %}
                                {% set avisExistant = a %}
                            {% endif %}
                        {% endfor %}

                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>{{ commande.numeroCommande }}</strong>
                                <span class="badge 
                                    {% if commande.statut == 'Livré' %}bg-success
                                    {% elseif commande.statut == 'Annulé' %}bg-danger
                                    {% elseif commande.statut == 'En attente' %}bg-warning text-dark
                                    {% else %}bg-secondary{% endif %}">
                                    {{ commande.statut }}
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                Prestation le {{ commande.datePrestation }} à {{ commande.heureLivraison }}
                            </div>
                            <div class="mt-1">
                                Total : <strong>{{ (commande.prixMenu + commande.prixLivraison)|number_format(2, ',', ' ') }} €</strong>
                            </div>

                            <div class="mt-2 d-flex gap-2">
                                <a href="{{ path('app_commande_show', {'id': commande.id}) }}" class="btn btn-sm btn-outline-secondary">Voir le détail</a>
                                {% if commande.statut == 'En attente' %}
                                    <a href="{{ path('app_commande_annuler_client', {'id': commande.id}) }}" 
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Confirmer l\'annulation ?')">Annuler</a>
                                {% endif %}
                            </div>

                            {% if commande.statut == 'Livré' and avisExistant is null %}
                                <div class="mt-3 border-top pt-3">
                                    <p class="small text-muted mb-2">Votre avis sur cette prestation :</p>
                                    <a href="{{ path('app_avis_new', {'commande': commande.id}) }}" class="btn btn-sm btn-outline-success">
                                        Laisser un avis
                                    </a>
                                </div>
                            {% elseif avisExistant is not null %}
                                <div class="mt-3 border-top pt-3 text-muted small">
                                    Avis déposé le {{ avisExistant.datePublication|date('d/m/Y') }} — note : {{ avisExistant.note }}/5
                                </div>
                            {% endif %}

                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        {% endif %}
    {% endif %}

</div>
    
{% endblock %}